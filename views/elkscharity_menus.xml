              parent="menu_elkscharity_hours"
              action="action_charity_pr_lines_import"
              sequence="45"
              groups="group_elkscharity_secretary"/>

    <menuitem id="menu_elkscharity_wrapup"
              name="Year-End Wrap-Up"
              parent="menu_elkscharity_hours"
              action="action_yearly_wrapup_wizard"
              sequence="30"
              groups="group_elkscharity_secretary"/>

    <!-- Timecards / Reports -->
    <menuitem id="menu_elkscharity_reports"
              name="Reports"
              parent="menu_elkscharity_root"
              sequence="40"/>

    <menuitem id="menu_elkscharity_grand_lodge_report"
              name="Grand Lodge Charity Report"
              parent="menu_elkscharity_reports"
              action="action_grand_lodge_report_wizard"
              sequence="5"/>

    <menuitem id="menu_elkscharity_annual_report"
              name="Charity Annual Report"
              parent="menu_elkscharity_reports"
              action="action_charity_annual_report_wizard"
              sequence="7"
              groups="group_elkscharity_secretary"/>

    <!-- Timecard Report menus moved to elksattendance module -->

    <menuitem id="menu_elkscharity_config"
              name="Configuration"
              parent="menu_elkscharity_root"
              sequence="99"
              groups="group_elkscharity_secretary"/>

    <menuitem id="menu_elkscharity_categories"
              name="GL Categories"
              parent="menu_elkscharity_config"
              action="action_elks_charity_category"
              sequence="10"/>

    <!-- Self-install wizard for Playwright + Chromium (used by the
         elks.org auto-push).  One-time setup step for the server. -->
    <menuitem id="menu_elkscharity_elks_org_setup"
              name="Elks.org Push Setup"
              parent="menu_elkscharity_config"
              action="action_elks_org_setup_wizard"
              sequence="80"/>

    <!-- Manual "Rebuild Attendance Contributions" trigger.  Same
         backfill that runs in the 19.0.7.1 post-migrate, but on
         demand from the Configuration menu.  Useful when the
         migration didn't fire (e.g., upgrading module while Odoo
         thought the version was already applied) or after bulk
         importing historical attendance.

         Logic is INLINED here rather than calling a method on the
         model because -u elkscharity reloads XML/data but does not
         re-import Python code; if a fresh method was just added,
         the XML would upgrade before the Python class did, giving
         AttributeError on click.  Inlining sidesteps that. -->
    <record id="action_rebuild_attendance_contributions"
            model="ir.actions.server">
        <field name="name">Rebuild Attendance Contributions</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">
Att = env['hr.attendance'].sudo()
Contrib = env['elks.charity.contribution'].sudo()
before = Contrib.search_count([('x_source', '=', 'attendance')])
historical = Att.search([
    ('x_charity_task_id', '!=', False),
    ('x_validated', '=', True),
    ('check_out', '!=', False),
])
if historical:
    historical._ensure_attendance_contribution()
after = Contrib.search_count([('x_source', '=', 'attendance')])
delta = after - before
action = {
    'type': 'ir.actions.client',
    'tag': 'display_notification',
    'params': {
        'title': 'Rebuild Attendance Contributions',
        'message': (
            'Scanned %d validated charity attendance row(s).  '
            'Attendance-sourced contributions: %d before -> %d '
            'after (%+d new/updated).  Refresh "Pending Elks.org '
            'Push" to see them.'
        ) % (len(historical), before, after, delta),
        'sticky': True,
        'type': 'success' if delta &gt;= 0 else 'warning',
    },
}
        </field>
    </record>

    <menuitem id="menu_elkscharity_rebuild_att_contribs"
              name="Rebuild Attendance Contributions"
              parent="menu_elkscharity_config"
              action="action_rebuild_attendance_contributions"
              sequence="90"/>

    <!-- Import Personal Records — dedicated act_window on
         account.analytic.line filtered to charity personal-record
         lines, with Import Records enabled.  The "All Charity Hours"
         menu points at a SQL view (elks.charity.hours.report) which
         can't accept imports; this fills that gap so the Secretary
         can bulk-import per-Elk attribution CSVs from the ⚙ menu. -->
    <record id="action_charity_pr_lines_import"
            model="ir.actions.act_window">
        <field name="name">Import Personal Records</field>
        <field name="res_model">account.analytic.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[
            ('x_personal_record', '=', True),
            ('project_id.x_is_charity_parent', '=', True),
        ]</field>
        <field name="context">{
            'default_x_personal_record': True,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No personal-record lines yet
            </p>
            <p>
                Click <em>⚙ → Import Records</em> above to bulk-import
                per-Elk attribution CSVs (leader hours per class,
                mileage per volunteer, etc.).  Required columns:
                <code>project_id</code>, <code>task_id</code>,
                <code>employee_id</code>, <code>date</code>,
                <code>name</code>, <code>unit_amount</code>,
                <code>x_is_helper</code>, <code>x_personal_record</code>,
                <code>x_miles</code>.
            </p>
        </field>
    </record>

</odoo>
