<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root menu points DIRECTLY at the dashboard act_window —
         no ir.actions.server wrapper.  We used to wrap it in a code
         server action so we could inject a dynamic current_lodge_year
         value, but Odoo 19 doesn't expose groups_id on ir.actions.server,
         which meant only System admins could run it.  The
         "Current Lodge Year" filter in the search view does its own
         date math and is now auto-activated via the act_window's
         context={'search_default_filter_current_lodge_year': 1}
         (see charity_dashboard_views.xml).  Regression seen
         2026-07-28 on lewistonelks896.com. -->

    <!-- Root: Elks Charity -->
    <menuitem id="menu_elkscharity_root"
              name="Elks Charity"
              sequence="55"
              action="action_charity_dashboard"
              web_icon="elkscharity,static/description/icon.png"
              groups="group_elkscharity_user"/>

    <menuitem id="menu_elkscharity_dashboard"
              name="Dashboard"
              parent="menu_elkscharity_root"
              action="action_charity_dashboard"
              sequence="5"/>

    <!-- Direct shortcut to the BPOE Data Collection Survey form so
         volunteers can drop in entries without drilling into a
         dashboard card or task first. -->
    <menuitem id="menu_elkscharity_quick_entry"
              name="Quick Entry"
              parent="menu_elkscharity_root"
              action="action_charity_quick_entry_wizard"
              sequence="8"/>

    <menuitem id="menu_elkscharity_projects"
              name="Charity Projects"
              parent="menu_elkscharity_root"
              action="action_charity_projects"
              sequence="10"/>

    <menuitem id="menu_elkscharity_activities"
              name="Charity Activities"
              parent="menu_elkscharity_root"
              action="action_charity_activities"
              sequence="20"/>

    <!-- ── Contributions ───────────────────────────────────── -->
    <menuitem id="menu_elkscharity_contributions"
              name="Contributions"
              parent="menu_elkscharity_root"
              sequence="25"/>

    <menuitem id="menu_elkscharity_contributions_all"
              name="All Contributions"
              parent="menu_elkscharity_contributions"
              action="action_charity_contributions"
              sequence="10"/>

    <menuitem id="menu_elkscharity_contributions_pending"
              name="Pending Review"
              parent="menu_elkscharity_contributions"
              action="action_charity_contributions_pending"
              sequence="20"
              groups="group_elkscharity_secretary"/>

    <menuitem id="menu_elkscharity_contributions_recurring"
              name="Recurring Templates"
              parent="menu_elkscharity_contributions"
              action="action_charity_contributions_recurring"
              sequence="30"
              groups="group_elkscharity_secretary"/>

    <menuitem id="menu_elkscharity_contributions_pending_push"
              name="Pending Elks.org Push"
              parent="menu_elkscharity_contributions"
              action="action_charity_contributions_pending_push"
              sequence="25"
              groups="group_elkscharity_secretary"/>

    <!-- ── Hours ───────────────────────────────────────────── -->
    <menuitem id="menu_elkscharity_hours"
              name="Hours"
              parent="menu_elkscharity_root"
              sequence="30"/>

    <menuitem id="menu_elkscharity_hours_all"
              name="All Charity Hours"
              parent="menu_elkscharity_hours"
              action="action_charity_hours_unified"
              sequence="10"/>

    <!-- "Hours Awaiting Validation" menu retired 19.0.6.5, record
         fully removed 19.0.6.10.  Charity attendance auto-validates
         on save so this list would always be empty.  Any existing
         menu record from prior installs is removed via
         migrations/19.0.6.10/post-migrate.py.  Nothing else in the
         codebase references the xmlid. -->

    <menuitem id="menu_elkscharity_missing_category"
              name="Missing Charity Category"
              parent="menu_elkscharity_hours"
              action="action_charity_attendance_missing_category"
              sequence="25"
              groups="group_elkscharity_secretary"/>

    <menuitem id="menu_elkscharity_wrapup"
              name="Year-End Wrap-Up"
              parent="menu_elkscharity_hours"
              action="action_yearly_wrapup_wizard"
              sequence="30"
              groups="group_elkscharity_secretary"/>

    <!-- Timecards / Reports -->
    <menuitem id="menu_elkscharity_reports"
              name="Reports"
              parent="menu_elkscharity_root"
              sequence="40"/>

    <menuitem id="menu_elkscharity_grand_lodge_report"
              name="Grand Lodge Charity Report"
              parent="menu_elkscharity_reports"
              action="action_grand_lodge_report_wizard"
              sequence="5"/>

    <menuitem id="menu_elkscharity_annual_report"
              name="Charity Annual Report"
              parent="menu_elkscharity_reports"
              action="action_charity_annual_report_wizard"
              sequence="7"
              groups="group_elkscharity_secretary"/>

    <!-- Timecard Report menus moved to elksattendance module -->

    <menuitem id="menu_elkscharity_config"
              name="Configuration"
              parent="menu_elkscharity_root"
              sequence="99"
              groups="group_elkscharity_secretary"/>

    <menuitem id="menu_elkscharity_categories"
              name="GL Categories"
              parent="menu_elkscharity_config"
              action="action_elks_charity_category"
              sequence="10"/>

    <!-- Self-install wizard for Playwright + Chromium (used by the
         elks.org auto-push).  One-time setup step for the server. -->
    <menuitem id="menu_elkscharity_elks_org_setup"
              name="Elks.org Push Setup"
              parent="menu_elkscharity_config"
              action="action_elks_org_setup_wizard"
              sequence="80"/>

    <!-- Manual "Rebuild Attendance Contributions" trigger.  Same
         backfill that runs in the 19.0.7.1 post-migrate, but on
         demand from the Configuration menu.  Useful when the
         migration didn't fire (e.g., upgrading module while Odoo
         thought the version was already applied) or after bulk
         importing historical attendance. -->
    <record id="action_rebuild_attendance_contributions"
            model="ir.actions.server">
        <field name="name">Rebuild Attendance Contributions</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">action = env['hr.attendance'].sudo().rebuild_attendance_contributions_button()</field>
    </record>

    <menuitem id="menu_elkscharity_rebuild_att_contribs"
              name="Rebuild Attendance Contributions"
              parent="menu_elkscharity_config"
              action="action_rebuild_attendance_contributions"
              sequence="90"/>
</odoo>
