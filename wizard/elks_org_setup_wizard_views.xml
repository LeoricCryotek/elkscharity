<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_elks_org_setup_wizard_form" model="ir.ui.view">
        <field name="name">elks.charity.elks_org_setup_wizard.form</field>
        <field name="model">elks.charity.elks_org_setup_wizard</field>
        <field name="arch" type="xml">
            <form string="Elks.org Push Chrome Extension">
                <sheet>
                    <div class="oe_title">
                        <h1>Elks.org Push — Chrome Extension</h1>
                        <p class="text-muted">
                            All auto-push mechanics live in a small
                            Chrome extension that talks to Odoo with an
                            API key you generate under Preferences.
                            Nothing to install on the server itself.
                        </p>
                    </div>

                    <div class="alert alert-success" role="alert">
                        <h3 style="margin-top:0;">One-time install per Secretary</h3>
                        <ol>
                            <li>
                                Get the extension folder onto the
                                Secretary's computer.  Simplest:
                                <code>git clone</code> the elkscharity
                                repo, then point Chrome at the
                                <code>extension/</code> subfolder.
                                Or zip it up on the server and email
                                it over.
                            </li>
                            <li>
                                In Chrome, open <code>chrome://extensions/</code>.
                            </li>
                            <li>
                                Turn on <strong>Developer mode</strong>
                                (top right).
                            </li>
                            <li>
                                Click <strong>Load unpacked</strong>,
                                pick the <code>extension/</code> folder.
                            </li>
                            <li>
                                The "Elks.org Charity Push" icon appears
                                in the toolbar.
                            </li>
                            <li>
                                In Odoo, go to <em>Preferences → Elks.org
                                Credentials → Regenerate API Key</em> and
                                copy the shown key.
                            </li>
                            <li>
                                Click the extension icon.  Paste the
                                Odoo URL + API Key.  Check <em>Enabled</em>,
                                click <em>Save</em>.
                            </li>
                            <li>
                                Log into <a href="https://www.elks.org"
                                target="_blank">elks.org</a> in a normal
                                tab.  Leave it open.
                            </li>
                        </ol>
                        <p style="margin-bottom:0;">
                            <strong>Extension folder path on this server:</strong>
                            <br/>
                            <field name="extension_path_hint"
                                   readonly="1" nolabel="1"/>
                        </p>
                    </div>

                    <div class="alert alert-info" role="alert" style="margin-top:12px;">
                        <strong>Verify with Dry Run first.</strong>
                        In the extension popup, tick <em>Dry Run</em>
                        before enabling.  Dry Run marks contributions
                        as pushed in Odoo WITHOUT actually submitting to
                        elks.org — the payloads log to the browser
                        DevTools console so you can inspect them.
                        Unchecked = live push to elks.org's real Grand
                        Lodge Reporting system.
                    </div>
                </sheet>
                <footer>
                    <button string="Close"
                            class="btn-primary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_elks_org_setup_wizard"
            model="ir.actions.act_window">
        <field name="name">Elks.org Push Setup</field>
        <field name="res_model">elks.charity.elks_org_setup_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
