              action="action_charity_attendance_helper_audit"
              sequence="27"
              groups="group_elkscharity_secretary"/>

    <!-- Bulk import options moved to Hours (19.0.7.18) so they're
         one click away when the Secretary is working with charity
         hours, instead of buried under Configuration. -->
    <menuitem id="menu_elkscharity_import_hours_under_hours"
              name="Import Volunteer Hours (paste)"
              parent="menu_elkscharity_hours"
              action="action_attendance_import_wizard"
              sequence="40"
              groups="group_elkscharity_secretary"/>

    <menuitem id="menu_elkscharity_import_pr_lines_under_hours"
