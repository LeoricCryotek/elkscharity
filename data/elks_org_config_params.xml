<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Config parameter for the Chrome-extension elks.org push.  Loaded
      with noupdate="1" so the lodge can override the URL (e.g. when
      elks.org changes their endpoint) without losing the custom value
      on the next module upgrade.

      Where to change it:
          Settings → Technical → System Parameters
          Filter for  elkscharity.elks_org_*

      History:  the legacy elks_org_login_url param was dropped in
      19.0.6.2 with the rest of the server-side push code.  The
      extension authenticates through the user's live browser session
      instead of Odoo posting credentials, so no login URL is needed.
    -->
    <data noupdate="1">

        <record id="elks_org_form_url" model="ir.config_parameter">
            <field name="key">elkscharity.elks_org_form_url</field>
            <field name="value">https://www.elks.org/grandlodge/charity/local.cfm</field>
        </record>

    </data>
</odoo>
